# Agentic Advent of Code Solver - configuration template (no secrets in this file).
# Copy to ..\aps-data\.env (recommended; scripts set APS_ENV_FILE) or to .env in the repo root.
# Never commit the real file.

# --- Runtime -----------------------------------------------------------------------------------
# Data directory for SQLite state, puzzle cache and inputs. Keep it OUTSIDE the worktrees.
APS_DATA_DIR=../aps-data
APS_HOST=127.0.0.1
APS_PORT=8765
APS_CORS_ORIGINS=http://127.0.0.1:5175,http://localhost:5175
APS_LOG_LEVEL=INFO
APS_REPO_URL=https://github.com/your-org/agentic-puzzle-solver

# --- Advent of Code (backend only; never sent to models, sandbox or browser) --------------------
# Value of the "session" cookie after logging in at https://adventofcode.com in your browser.
AOC_SESSION=
# Contact for the User-Agent header (requested by the site's automation guidance).
AOC_CONTACT=you@example.com
# Minimum seconds between requests to adventofcode.com (floor 1).
AOC_MIN_INTERVAL_S=5

# --- Microsoft Foundry: workhorse (Responses API, v1) ------------------------------------------
# From `azd env get-values` after `azd provision` (output FOUNDRY_OPENAI_BASE_URL)
FOUNDRY_OPENAI_BASE_URL=https://<resource>.openai.azure.com/openai/v1
WORKHORSE_DEPLOYMENT=gpt-6.1-sol
WORKHORSE_DISPLAY_NAME=GPT-6.1 Sol
# Leave empty to use Entra ID (az login / DefaultAzureCredential) - recommended.
FOUNDRY_OPENAI_API_KEY=

# --- Microsoft Foundry: escalation (Claude Messages API) ---------------------------------------
FOUNDRY_ANTHROPIC_BASE_URL=https://<resource>.services.ai.azure.com/anthropic
ESCALATION_DEPLOYMENT=claude-opus-5-5
ESCALATION_DISPLAY_NAME=Claude Opus 5.5
FOUNDRY_ANTHROPIC_API_KEY=

# --- Azure Container Apps Dynamic Sessions -----------------------------------------------------
SESSIONS_POOL_ENDPOINT=https://<region>.dynamicsessions.io/subscriptions/<sub>/resourceGroups/<rg>/sessionPools/<pool>
SESSIONS_API_VERSION=2025-10-02-preview

# --- Pricing (USD per 1M tokens). VERIFY current prices; values are not hardcoded in code. -----
WORKHORSE_PRICE_INPUT_PER_MTOK=0
WORKHORSE_PRICE_OUTPUT_PER_MTOK=0
ESCALATION_PRICE_INPUT_PER_MTOK=0
ESCALATION_PRICE_OUTPUT_PER_MTOK=0
DEFAULT_MAX_SPEND_USD=20
